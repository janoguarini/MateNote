# OpenAI — powers transcript analysis (summary, hooks, structure, ideas).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini if unset.
OPENAI_MODEL=

# YouTube Data API — optional. Enables exact video duration enrichment,
# the Research page (creator/topic search), and the Trends page (real
# trending videos). Without it, MateNote still works end-to-end using
# YouTube's public oEmbed endpoint for metadata, but Research/Trends will
# show a "not configured" state instead of fabricating data.
# Get a key at https://console.cloud.google.com/apis/credentials
# (enable the "YouTube Data API v3" on the project first)
YOUTUBE_API_KEY=

# Supabase — database + auth. Required for accounts, saving analyses, and
# the dashboard/research/saved/trends pages. Without it, the landing page
# and one-off /analyze flow still work, but nothing is persisted.
# Get these from your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser. Used to
# write analyses to the shared cache. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=
